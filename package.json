{
  "name": "colombia-tax-calculator",
  "version": "1.2.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "node scripts/start.js",
    "start:ui": "vite --open",
    "start:cli": "tsx -r dotenv/config src/cli.ts",
    "dev": "vite",
    "build": "npm run clean && tsc -p tsconfig.build.json && vite build",
    "postbuild": "node scripts/fix-imports.js",
    "clean": "rimraf dist dist-ui",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "decimal.js": "10.4.3",
    "dotenv": "16.4.7",
    "pino": "10.0.0",
    "pino-pretty": "10.3.1",
    "prompt-sync": "4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tty-table": "4.2.3"
  },
  "devDependencies": {
    "@types/node": "20.11.0",
    "@types/prompt-sync": "4.2.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "8.56.0",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-config-airbnb-typescript": "18.0.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "2.29.1",
    "prettier": "3.2.0",
    "rimraf": "5.0.5",
    "tsx": "4.20.6",
    "typescript": "5.2.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
